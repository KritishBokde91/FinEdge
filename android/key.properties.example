# FinSight AI - Release Signing Configuration Template
# Copy this file to android/key.properties (which is gitignored) and fill in your actual credentials.
#
# To generate a new keystore, run:
# keytool -genkey -v -keystore finsight-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias finsight
#
storePassword=your_store_password_here
keyPassword=your_key_password_here
keyAlias=finsight
storeFile=../finsight-release.jks
